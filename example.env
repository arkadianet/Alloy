# example.env — copy to your own .env manually; Alloy never writes .env
# Alloy also never auto-loads .env: export vars into the process environment
# (or use your shell/direnv tooling) before starting Alloy.
# Author: arkadianet

# Provider key name referenced by router.toml api_key_env (RFC-0007).
# Must match [[providers]].api_key_env in your active router.toml.
# Unset/empty → router construction fails closed. Alloy never writes .env.
ALLOY_API_KEY=

# Optional overrides (process env; Alloy never writes .env)
# ALLOY_DATA_DIR=                 # data dir (else <workspace>/.alloy else XDG)
# ALLOY_PROFILE=profiles/default.toml
# ALLOY_ROUTER=router.toml        # active router (copy from router.toml.example)
# RUST_LOG=alloy_runtime=info,alloy=info   # `alloy` is the bin target, not `alloy_cli`

# Storage (RFC-0002) — optional
# ALLOY_SQLITE_BUSY_TIMEOUT_MS=5000
# ALLOY_SQLITE_SYNCHRONOUS=NORMAL
# ALLOY_STORAGE_WAL=true
# ALLOY_STORAGE_ORPHAN_SCAN=false
# ALLOY_STORAGE_ORPHAN_SCAN_LIMIT=1024

# Sandbox (RFC-0005) — optional process-env overrides; Alloy never writes .env
# ALLOY_CONTAINER_RUNTIME=docker
# ALLOY_CONTAINER_IMAGE=docker.io/library/rust:1.97.1-bookworm

# Scheduler (RFC-0010) — no required env keys.
# Parallelism honesty lives in profile [budgets] (max_parallel_*=1).
# Optional future: ALLOY_SCHED_CANCEL_GRACE_MS=5000

# Precedence (RFC-0015 PR1): process environment > CLI flags > profile TOML
# > built-in defaults. ALLOY_DATA_DIR beats any flag; ALLOY_PROFILE names the
# profile *file* while `--profile` names the catalog id, and when both are
# set the file's [profile].id must match the flag (PR3).

# Project graph (RFC-0011 / RFC-0015 IX6): MVP introduces no ALLOY_GRAPH_*
# environment knobs. When one is added it must be documented here first.

# Test-only knobs (never read by production paths): ALLOY_BLESS,
# ALLOY_REQUIRE_LANDLOCK, ALLOY_REQUIRE_SEATBELT, ALLOY_LIVE_ROUTER_TOML,
# ALLOY_STORAGE_CRASH_DIR.
