# router.toml.example — Author: arkadianet
# Copy to router.toml (active config). Alloy never writes .env.
# Set `model` and `base_url` for your openai-compatible provider (BYOM).
# Public providers must use https; http is allowed only for loopback local servers.
# api_key_env names a process env var (see example.env); Alloy never invents keys.
#
# Schema owned by RFC-0007 (Architecture V2 §11.2).

[policy]
default_tier = "standard"
connect_timeout_ms = 10000
request_timeout_ms = 120000
shutdown_grace_ms = 5000
max_in_flight = 32

# Stubbed unused in MVP (ADR F-20). Parsed if present; MUST NOT affect routing.
[policy.scoring]
# complexity_weight = 0.0
# budget_weight = 0.0
# latency_weight = 0.0

[[providers]]
id = "openai-compatible-main"
kind = "openai_compatible"
base_url = "https://api.example.com/v1"
api_key_env = "ALLOY_API_KEY"

[[providers.endpoints]]
id = "team-workhorse"
display_name = "Workhorse"
# Wire model id — operator-supplied BYOM value. Not hardcoded in Alloy core.
model = "REPLACE_ME"
tiers = ["standard"]
supports_tools = true
supports_structured_output = true
max_context = 200000
# Optional USD per 1_000_000 tokens for metering (RFC-0004 / RFC-0007).
# Omit both to leave ModelCallRecord.usd as null (never invent prices).
# input_usd_per_mtok = 0.0
# output_usd_per_mtok = 0.0

[capability_tiers]
repair = "standard"
edit = "standard"
review = "economy"
planning = "standard"
