# router.toml.example — Author: arkadianet
# Copy to router.toml (active config). Alloy never writes .env.
# Set `model` and `base_url` for your openai-compatible provider (BYOM).
# Public providers must use https; http is allowed only for loopback local servers.
# api_key_env names a process env var (see example.env); Alloy never invents keys.
#
# Schema owned by RFC-0007 (Architecture V2 §11.2).

[policy]
default_tier = "standard"
connect_timeout_ms = 10000
request_timeout_ms = 120000
shutdown_grace_ms = 5000
max_in_flight = 32

# Stubbed unused in MVP (ADR F-20). Parsed if present; MUST NOT affect routing.
[policy.scoring]
# complexity_weight = 0.0
# budget_weight = 0.0
# latency_weight = 0.0

[[providers]]
id = "openai-compatible-main"
kind = "openai_compatible"
base_url = "https://api.example.com/v1/"
api_key_env = "ALLOY_API_KEY"

[[providers.endpoints]]
id = "team-workhorse"
display_name = "Workhorse"
# Wire model id — operator-supplied BYOM value. Not hardcoded in Alloy core.
model = "REPLACE_ME"
tiers = ["standard"]
supports_tools = true
supports_structured_output = true
# JSON-Schema response format (RFC-0007 A-0007-2): opt in only if the server
# accepts response_format = {type = "json_schema", ...} (OpenAI, vLLM,
# Ollama >= 0.5, llama.cpp). Default false: workers' JSON Schemas are then
# withheld and requests degrade to plain json_object.
# Enforcement is server-dependent: grammar-constraining servers (vLLM,
# Ollama, llama.cpp) decode against the schema; OpenAI-style servers treat
# it as best-effort unless json_schema_strict is also set.
# Requires supports_structured_output = true.
supports_json_schema = false
# Serialize "strict": true (OpenAI strict structured outputs). Default
# false: local servers ignore it, and OpenAI strict mode rejects schemas
# outside its subset (e.g. required narrower than properties). Requires
# supports_json_schema = true.
json_schema_strict = false
max_context = 200000
# Optional sampling temperature (0.0..=2.0); omit for the provider default.
# Low values suit mechanical repair/edit work (issue #53).
temperature = 0.2
# Under default profile max_usd_per_run > 0, both price fields are REQUIRED.
input_usd_per_mtok = 0.0
output_usd_per_mtok = 0.0

# Tier escalation target (RFC-0010 §5.11.4 ES1). The shipped
# `repair_local_diagnostic` template escalates its analyze/edit nodes to
# `premium` on their retry, so uncomment an endpoint serving `premium` (a
# bigger model) to give that retry somewhere better to land.
#
# Leaving this commented is supported and safe. With no `premium` endpoint the
# escalated retry routes at the capability's configured tier instead — exactly
# where it would have run without escalation — and the route decision records
# `escalation_unserved = true` (metric `routes_escalation_unserved`). You lose
# the escalation, not the retry. What is never allowed is the reverse: an
# escalation can only raise a tier, never lower one (RFC-0007 §5.2.1).
# [[providers.endpoints]]
# id = "team-premium"
# display_name = "Premium"
# model = "REPLACE_ME_PREMIUM"
# tiers = ["premium"]
# supports_tools = true
# supports_structured_output = true
# max_context = 200000
# input_usd_per_mtok = 0.0
# output_usd_per_mtok = 0.0

[[providers.endpoints]]
id = "team-economy"
display_name = "Economy"
model = "REPLACE_ME_ECONOMY"
tiers = ["economy"]
supports_tools = false
supports_structured_output = false
max_context = 128000
input_usd_per_mtok = 0.0
output_usd_per_mtok = 0.0

[capability_tiers]
repair = "standard"
edit = "standard"
review = "economy"
planning = "standard"
