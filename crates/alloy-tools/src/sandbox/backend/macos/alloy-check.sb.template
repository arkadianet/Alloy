;; Alloy Seatbelt profile template (RFC-0005).
;; Placeholders: {{JAIL}} {{TMP}} {{HOME}} {{BROKER_DIR}}
;; RO cargo/rustup roots and deny clauses are appended by the broker from
;; IsolateContext (must match Linux allowlisted_ro_subtrees).
;; {{BROKER_DIR}} is outside the jail (SBPL + trampoline); never jail-writable.
;; Do NOT grant whole /tmp — only the broker-owned leaf directory.
(version 1)
(deny default)
(allow process*)
(allow signal)
(allow sysctl-read)
(allow mach-lookup)
(allow file-read-metadata)
(allow file-read* file-write* (subpath {{JAIL}}))
(allow file-read* file-write* (subpath {{TMP}}))
(allow file-read* file-write* (subpath {{HOME}}))
(allow file-read* (subpath {{BROKER_DIR}}))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/Library"))
(allow file-read* file-write* (literal "/dev/null"))
(allow file-read* (literal "/dev/urandom"))
(allow file-read* (literal "/dev/zero"))
(allow file-read* (subpath "/dev"))
(allow file-read* (subpath "/private/var/db/timezone"))
(deny network*)
