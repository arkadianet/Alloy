;; Alloy Seatbelt profile template (RFC-0005).
;; Placeholders: {{JAIL}} {{TMP}} {{HOME}} {{CARGO_REGISTRY}} {{CARGO_GIT}} {{CARGO_BIN}} {{RUSTUP_TOOLCHAINS}} {{RUSTUP_SETTINGS}}
;; Deny clauses for credential/deny-glob paths are appended by the broker.
;; Whole CARGO_HOME / RUSTUP_HOME are NOT granted — allowlisted subtrees only.
(version 1)
(deny default)
(allow process*)
(allow signal)
(allow sysctl-read)
(allow mach-lookup)
(allow file-read-metadata)
(allow file-read* file-write* (subpath {{JAIL}}))
(allow file-read* file-write* (subpath {{TMP}}))
(allow file-read* file-write* (subpath {{HOME}}))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/Library"))
(allow file-read* file-write* (literal "/dev/null"))
(allow file-read* (literal "/dev/urandom"))
(allow file-read* (literal "/dev/zero"))
(allow file-read* (subpath "/dev"))
(allow file-read* (subpath "/private/var/db/timezone"))
(allow file-read* (subpath {{CARGO_REGISTRY}}))
(allow file-read* (subpath {{CARGO_GIT}}))
(allow file-read* (subpath {{CARGO_BIN}}))
(allow file-read* (subpath {{RUSTUP_TOOLCHAINS}}))
(allow file-read* (literal {{RUSTUP_SETTINGS}}))
(deny network*)
