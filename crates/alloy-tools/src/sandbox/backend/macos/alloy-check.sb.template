;; Alloy Seatbelt profile template (RFC-0005).
;; Placeholders: {{JAIL}} {{TMP}} {{HOME}} {{BROKER_DIR}}
;; RO cargo/rustup roots and deny clauses are appended by the broker from
;; IsolateContext (must match Linux allowlisted_ro_subtrees).
;; {{BROKER_DIR}} is outside the jail (SBPL + trampoline); never jail-writable.
(version 1)
(deny default)
;; Explicit process rules only — no broad process* / process-exec*.
(allow process-fork)
(allow process-info*)
(allow signal)
(allow sysctl-read)
(allow mach-lookup)
(allow file-read-metadata)
;; Inherited stdio / ready-byte pipes (vnode-type PIPE is unbound on modern macOS).
(allow file-write* (regex #"^(/private)?/dev/fd/"))
(allow file-ioctl (regex #"^(/private)?/dev/fd/"))
(allow file-read* file-write* (subpath {{JAIL}}))
(allow file-read* file-write* (subpath {{TMP}}))
(allow file-read* file-write* (subpath {{HOME}}))
(allow file-read* (subpath {{BROKER_DIR}}))
(allow process-exec (subpath {{BROKER_DIR}}))
(allow process-exec (literal "/bin/bash"))
(allow process-exec (literal "/bin/sh"))
(allow process-exec (literal "/usr/bin/true"))
(allow process-exec (literal "/usr/bin/false"))
(allow process-exec (literal "/usr/bin/env"))
(allow process-exec (literal "/usr/bin/xcrun"))
(allow process-exec (literal "/usr/bin/clang"))
(allow process-exec (literal "/usr/bin/clang++"))
(allow process-exec (literal "/usr/bin/cc"))
(allow process-exec (literal "/usr/bin/c++"))
(allow process-exec (literal "/usr/bin/ld"))
(allow process-exec (literal "/usr/bin/ar"))
(allow process-exec (literal "/usr/bin/as"))
(allow process-exec (literal "/usr/bin/lipo"))
(allow process-exec (literal "/usr/bin/dsymutil"))
(allow process-exec (literal "/usr/bin/codesign"))
(allow process-exec (literal "/usr/bin/sw_vers"))
(allow process-exec (subpath "/usr/lib"))
(allow process-exec (subpath "/usr/bin"))
(allow process-exec (subpath "/bin"))
(allow process-exec (subpath "/sbin"))
(allow process-exec (subpath "/Library/Developer/CommandLineTools"))
(allow process-exec (subpath "/Applications/Xcode.app"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/Library"))
(allow file-read* (subpath "/private/etc"))
(allow file-read* (subpath "/etc"))
;; /dev is covered by the subpath grant; keep an explicit write for /dev/null.
(allow file-read* file-write* (literal "/dev/null"))
(allow file-read* (subpath "/dev"))
(allow file-read* (subpath "/private/var/db/timezone"))
(deny network*)
