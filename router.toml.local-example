# router.toml.local-example — Author: arkadianet
# Local-model dogfooding config (see docs/dogfooding.md).
# Copy to router.toml. http:// is allowed for loopback only (RFC-0007).

[policy]
default_tier = "standard"
connect_timeout_ms = 10000
# Local inference is slow; give completions room before the router times out.
request_timeout_ms = 600000
shutdown_grace_ms = 5000
max_in_flight = 2

[[providers]]
id = "local"
kind = "openai_compatible"
base_url = "http://127.0.0.1:11434/v1/"
# Ollama ignores the key but Alloy requires the env var to exist and never
# invents one: export ALLOY_API_KEY=local
api_key_env = "ALLOY_API_KEY"

[[providers.endpoints]]
id = "local-coder"
display_name = "Local coder"
# Must match the model id your server actually serves (`ollama list`).
model = "qwen2.5-coder:14b"
tiers = ["standard", "economy"]
supports_tools = true
supports_structured_output = true
# Schema-constrained decoding (RFC-0007 A-0007-2): Ollama >= 0.5 maps the
# OpenAI response_format = {type = "json_schema", ...} shape onto its native
# grammar-constrained `format`, so local models stop burning repair turns on
# malformed JSON. Set false if your server rejects the shape; Alloy then
# degrades that endpoint to plain json_object. Ollama constrains by grammar
# whether or not strict is sent, so json_schema_strict stays off here.
supports_json_schema = true
max_context = 32768
# Optional sampling temperature (0.0..=2.0); omit for the provider default.
# Moderate values suit repair with the retry loop: low temp re-samples the
# same wrong patch on retry; 0.4-0.6 lets retries explore (issue #53).
temperature = 0.6
# Local tokens are free; $0 keeps the budget meter honest.
input_usd_per_mtok = 0.0
output_usd_per_mtok = 0.0

# Tier escalation target (RFC-0010 §5.11.4 ES1). `repair_local_diagnostic`
# escalates analyze/edit to `premium` on their retry. To make that escalation
# mean something, serve `premium` with a bigger local model:
# `ollama pull qwen2.5-coder:32b`, then uncomment. (Lower-effort alternative:
# add "premium" to `local-coder`'s `tiers` above and the retry re-runs on the
# same model.)
#
# If you do neither, nothing breaks: with no `premium` endpoint the escalated
# retry routes at the configured tier — the same `local-coder` that just
# failed — and the route decision records `escalation_unserved = true`. An
# escalation only ever raises a tier; it never lowers one (RFC-0007 §5.2.1).
# [[providers.endpoints]]
# id = "local-coder-big"
# display_name = "Local coder (big)"
# model = "qwen2.5-coder:32b"
# tiers = ["premium"]
# supports_tools = true
# supports_structured_output = true
# max_context = 32768
# input_usd_per_mtok = 0.0
# output_usd_per_mtok = 0.0

[capability_tiers]
repair = "standard"
edit = "standard"
review = "economy"
planning = "standard"
