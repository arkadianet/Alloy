# router.toml.local-example — Author: arkadianet
# Local-model dogfooding config (see docs/dogfooding.md).
# Copy to router.toml. http:// is allowed for loopback only (RFC-0007).
#
# Preferred on RTX 3090: llama.cpp serving Qwen3-Coder-30B-A3B on :8089.
# Ollama (:11434) remains a fine alternative.
# supports_tools = true is a *routing* flag only — Alloy does not yet send
# OpenAI tools[] to the provider; host MCP builtins are used instead.

[policy]
default_tier = "standard"
connect_timeout_ms = 10000
# Local inference is slow; give completions room before the router times out.
request_timeout_ms = 600000
shutdown_grace_ms = 5000
max_in_flight = 2

[[providers]]
id = "local"
kind = "openai_compatible"
# llama.cpp (serve.sh). For Ollama use http://127.0.0.1:11434/v1/
base_url = "http://127.0.0.1:8089/v1/"
# Provider ignores the key but Alloy requires the env var to exist and never
# invents one: export ALLOY_API_KEY=local
api_key_env = "ALLOY_API_KEY"

[[providers.endpoints]]
id = "local-coder"
display_name = "Local coder (Qwen3-Coder-30B-A3B)"
# Must match the model id your server actually serves (`curl …/v1/models`).
model = "Qwen3-Coder-30B-A3B-Instruct-UD-Q6_K_XL.gguf"
tiers = ["standard", "economy", "premium"]
supports_tools = true
supports_structured_output = true
# Schema-constrained decoding (RFC-0007 A-0007-2): set true for Ollama >= 0.5;
# llama.cpp may reject json_schema — if so, omit or set false (Alloy degrades
# to plain json_object).
# supports_json_schema = true
max_context = 32768
# Optional sampling temperature (0.0..=2.0); omit for the provider default.
# Moderate values suit repair with the retry loop: low temp re-samples the
# same wrong patch on retry; 0.4-0.6 lets retries explore (issue #53).
temperature = 0.6
# Local tokens are free; $0 keeps the budget meter honest.
input_usd_per_mtok = 0.0
output_usd_per_mtok = 0.0

# Optional Ollama alt: switch base_url to :11434/v1/ and model to e.g.
# qwen3-coder:30b; set supports_json_schema = true for Ollama >= 0.5.
# Optional second denser endpoint for A-B: uncomment and assign tiers.
# [[providers.endpoints]]
# id = "local-coder-qwen25"
# display_name = "Local coder (Qwen2.5 dense)"
# model = "qwen2.5-coder:32b"
# tiers = ["premium"]
# supports_tools = true
# supports_structured_output = true
# max_context = 32768
# input_usd_per_mtok = 0.0
# output_usd_per_mtok = 0.0

[capability_tiers]
repair = "standard"
edit = "standard"
review = "economy"
planning = "standard"
